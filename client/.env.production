# Хостинги выставляют CI=true, а при нём Create React App считает любое
# предупреждение ошибкой и роняет сборку. Одна неиспользованная переменная —
# и деплой красный. В продакшен-сборке проверку стиля выключаем: она нужна
# при разработке, где её видно сразу, а не на чужом сервере через десять
# минут после коммита.
DISABLE_ESLINT_PLUGIN=true

# Собранный сайт отдаёт тот же адрес, что и API, поэтому базовый адрес пуст.
REACT_APP_API_URL=
