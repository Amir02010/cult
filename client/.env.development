# Адрес API для режима разработки (npm start).
# В production-сборке переменная не задаётся: сервер отдаёт сайт сам,
# и запросы идут на тот же адрес.
#
# Менять ничего не нужно и для проверки с телефона: если страница открыта
# по сетевому адресу вида http://192.168.1.110:3000, клиент сам подставит
# этот же адрес и порт 4000.
REACT_APP_API_URL=http://localhost:4000
